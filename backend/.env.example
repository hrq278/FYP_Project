PORT=3000
# Atlas: use the mongodb+srv:// string from Atlas. On networks that block DNS TXT
# lookups (queryTxt ETIMEOUT), use the standard mongodb://host1,host2,host3/... form.
MONGO_URI=mongodb://localhost:27017/maweshiai
JWT_SECRET=replace_with_a_long_random_string
ML_SERVICE_URL=http://localhost:8000

# Image storage (Module 2)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# LLM for reports, Q&A and compare (Module 3)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_API_KEY=your_api_key
