{
  "expo": {
    "name": "MaweshiAI",
    "slug": "maweshiai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F5F3A"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "supportsRTL": true
    },
    "android": {
      "backgroundColor": "#FAF7F0"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
