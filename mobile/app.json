{
  "expo": {
    "name": "MaweshiAI",
    "slug": "maweshiai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F5F3A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "MaweshiAI uses the camera to photograph the animal you want to buy.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "supportsRTL": true
    },
    "android": {
      "backgroundColor": "#FAF7F0",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1F5F3A"
      },
      "package": "com.maweshiai.app",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "icon": "./assets/images/icon.png"
  }
}
